# Required: API key for Nerd Completion (or place in ~/.claude/nerd-completion.json)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Override the LLM endpoint (default: https://nerd-completion.staging-service.nr-ops.net)
# ANTHROPIC_BASE_URL=https://nerd-completion.staging-service.nr-ops.net

# Optional: Override the model (default: claude-sonnet-4-6)
# LLM_MODEL_NAME=claude-sonnet-4-6

# Optional: Path to agents directory (default: ./agents)
# NR_DIAGNOSE_AGENTS_DIR=./agents
